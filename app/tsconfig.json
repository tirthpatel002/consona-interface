{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "types": [],
    "paths": {
      "react": ["./node_modules/@types/react"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "@/*": ["./src/*"],
      "@registry/registry.json": ["../registry/registry.json"],
      "@registry/metadata-registry.json": ["../registry/metadata-registry.json"],
      "@registry/*": ["../tools/registry/*"],
      "@registry": ["../tools/registry/index.ts"],
      "@consona/interface": ["../packages/interface/src/index.ts"],
      "@consona/interface-core": ["../packages/core/src/index.ts"],
      "@consona/interface-media": ["../packages/media/src/index.ts"],
      "@consona/interface-orb": ["../packages/orb/src/index.ts"],
      "@consona/interface-sound": ["../packages/sound/src/index.ts"],
      "@consona/interface-dnd": ["../packages/dnd/src/index.ts"],
      "@consona/interface-overlay": ["../packages/overlay/src/index.ts"],
      "@consona/interface-onboarding": ["../packages/onboarding/src/index.ts"],
      "@consona/interface-composites": ["../packages/composites/src/index.ts"],
      "@consona/interface-charts": ["../packages/charts/src/index.ts"],
      "@consona/interface-map": ["../packages/map/src/index.ts"],
      "@consona/interface-gantt": ["../packages/gantt/src/index.ts"],
      "@consona/interface-glass": ["../packages/glass/src/index.ts"],
      "@consona/interface-interaction": ["../packages/interaction/src/index.ts"],
      "@consona/interface-navigation": ["../packages/navigation/src/index.ts"],
      "@consona/interface/core": ["../packages/core/src/index.ts"],
      "@consona/interface/media": ["../packages/media/src/index.ts"],
      "@consona/interface/audio": ["../packages/media/src/index.ts"],
      "@consona/interface/styles.css": ["../packages/core/src/theme/styles.css"],
      "@consona/interface/*": ["../packages/*/src/index.ts"]
    }
  },
  "include": ["src"]
}
