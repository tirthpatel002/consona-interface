{
  "name": "consona-interface-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "Consona Interface monorepo — workspace root (not published)",
  "license": "MIT",
  "author": "Consona",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/build-all.mjs",
    "build:core": "npm run build -w @consona/interface-core",
    "build:all": "node scripts/build-all.mjs",
    "type-check": "npm run type-check --workspaces --if-present",
    "split:packages": "node scripts/split-packages.mjs",
    "build:registry": "node --experimental-strip-types tools/registry/builder.ts",
    "prepare:publish": "node scripts/prepare-publish.mjs",
    "publish:dry": "node scripts/publish-all.mjs --dry-run",
    "publish:all": "node scripts/publish-all.mjs",
    "publish:all:deprecate": "node scripts/publish-all.mjs --deprecate-old"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@nivo/bar": "^0.99.0",
    "@nivo/bump": "^0.99.0",
    "@nivo/chord": "^0.99.0",
    "@nivo/core": "^0.99.0",
    "@nivo/funnel": "^0.99.0",
    "@nivo/heatmap": "^0.99.0",
    "@nivo/line": "^0.99.0",
    "@nivo/pie": "^0.99.0",
    "@nivo/radar": "^0.99.0",
    "@nivo/radial-bar": "^0.99.0",
    "@nivo/sankey": "^0.99.0",
    "@nivo/scatterplot": "^0.99.0",
    "@nivo/stream": "^0.99.0",
    "@nivo/sunburst": "^0.99.0",
    "@nivo/treemap": "^0.99.0",
    "@types/d3-format": "^3.0.4",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "d3-format": "^3.1.2",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "maplibre-gl": "^6.9.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18"
  }
}
