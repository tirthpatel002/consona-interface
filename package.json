{
  "name": "@consona/interface",
  "version": "1.0.0",
  "description": "Consona Interface Enhanced \u2014 Micro-Kernel UI System on React Aria Components",
  "license": "MIT",
  "author": "Consona",
  "homepage": "https://github.com/tirthpatel002/consona-interface#readme",
  "bugs": {
    "url": "https://github.com/tirthpatel002/consona-interface/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tirthpatel002/consona-interface.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css",
    "./dist/theme/styles.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/theme/styles.css",
    "./core": {
      "types": "./dist/modules/core/index.d.ts",
      "import": "./dist/modules/core/index.js",
      "default": "./dist/modules/core/index.js"
    },
    "./navigation": {
      "types": "./dist/modules/navigation/index.d.ts",
      "import": "./dist/modules/navigation/index.js",
      "default": "./dist/modules/navigation/index.js"
    },
    "./media": {
      "types": "./dist/modules/media/index.d.ts",
      "import": "./dist/modules/media/index.js",
      "default": "./dist/modules/media/index.js"
    },
    "./audio": {
      "types": "./dist/modules/media/index.d.ts",
      "import": "./dist/modules/media/index.js",
      "default": "./dist/modules/media/index.js"
