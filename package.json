      "default": "./dist/modules/glass/index.js"
    },
    "./overlay": {
      "types": "./dist/modules/overlay/index.d.ts",
      "import": "./dist/modules/overlay/index.js",
      "default": "./dist/modules/overlay/index.js"
    },
    "./onboarding": {
      "types": "./dist/modules/onboarding/index.d.ts",
      "import": "./dist/modules/onboarding/index.js",
      "default": "./dist/modules/onboarding/index.js"
    },
    "./composites": {
      "types": "./dist/modules/composites/index.d.ts",
      "import": "./dist/modules/composites/index.js",
      "default": "./dist/modules/composites/index.js"
    },
    "./charts": {
      "types": "./dist/modules/charts/index.d.ts",
      "import": "./dist/modules/charts/index.js",
      "default": "./dist/modules/charts/index.js"
    },
    "./map": {
      "types": "./dist/modules/map/index.d.ts",
      "import": "./dist/modules/map/index.js",
      "default": "./dist/modules/map/index.js"
    },
    "./interaction": {
      "types": "./dist/modules/interaction/index.d.ts",
      "import": "./dist/modules/interaction/index.js",
      "default": "./dist/modules/interaction/index.js"
    },
    "./dnd": {
      "types": "./dist/modules/dnd/index.d.ts",
      "import": "./dist/modules/dnd/index.js",
      "default": "./dist/modules/dnd/index.js"
    },
    "./gantt": {
      "types": "./dist/modules/gantt/index.d.ts",
      "import": "./dist/modules/gantt/index.js",
      "default": "./dist/modules/gantt/index.js"
    },
    "./sound": {
      "types": "./dist/modules/sound/index.d.ts",
      "import": "./dist/modules/sound/index.js",
      "default": "./dist/modules/sound/index.js"
    },
    "./registry": {
      "types": "./dist/registry/index.d.ts",
      "import": "./dist/registry/index.js",
      "default": "./dist/registry/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-package-assets.mjs",
    "prebuild": "node --input-type=module -e \"import { rm } from 'node:fs/promises'; await rm('dist', { recursive: true, force: true })\"",
    "prepublishOnly": "npm run build",
    "build:package": "npm run build:registry && npm run type-check",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "build:registry": "node --experimental-strip-types src/registry/builder.ts",
    "audit:rules": "node --experimental-strip-types scripts/audit-rules.ts",
    "transforms": "node --experimental-strip-types scripts/mechanical-transforms.ts",
    "registrar": "node --experimental-strip-types scripts/registrar-cli.ts",
    "audit:slots": "node --experimental-strip-types scripts/diagnose-slots-and-factory.ts"
  },
  "keywords": [
    "consona",
    "interface",
    "react-aria",
    "design-system",
    "generative-ui",
    "micro-kernel"
  ],
