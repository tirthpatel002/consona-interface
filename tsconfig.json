{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": ["node", "react", "react-dom"],
    "paths": {
      "@consona/interface-core": ["./packages/core/src/index.ts"],
      "@consona/interface-core/*": ["./packages/core/src/*"],
      "@consona/interface-*": ["./packages/*/src/index.ts"]
    }
  },
  "include": ["packages/*/src/**/*", "tools/**/*", "scripts/**/*"],
  "exclude": ["packages/*/dist", "node_modules", "app"]
}
