{
  "name": "@consona/interface-dnd",
  "version": "1.0.0",
  "description": "Consona Interface dnd module",
  "license": "MIT",
  "author": "Consona",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./dnd-board": {
      "types": "./dist/components/dnd-board/index.d.ts",
      "import": "./dist/components/dnd-board/index.js",
      "default": "./dist/components/dnd-board/index.js"
    },
    "./drag-overlay": {
      "types": "./dist/components/drag-overlay/index.d.ts",
      "import": "./dist/components/drag-overlay/index.js",
      "default": "./dist/components/drag-overlay/index.js"
    },
    "./draggable": {
      "types": "./dist/components/draggable/index.d.ts",
      "import": "./dist/components/draggable/index.js",
      "default": "./dist/components/draggable/index.js"
    },
    "./droppable": {
      "types": "./dist/components/droppable/index.d.ts",
      "import": "./dist/components/droppable/index.js",
      "default": "./dist/components/droppable/index.js"
    },
    "./positionable": {
      "types": "./dist/components/positionable/index.d.ts",
      "import": "./dist/components/positionable/index.js",
      "default": "./dist/components/positionable/index.js"
    },
    "./sortable": {
      "types": "./dist/components/sortable/index.d.ts",
      "import": "./dist/components/sortable/index.js",
      "default": "./dist/components/sortable/index.js"
    },
    "./sortable-grid": {
      "types": "./dist/components/sortable-grid/index.d.ts",
      "import": "./dist/components/sortable-grid/index.js",
      "default": "./dist/components/sortable-grid/index.js"
    },
    "./sortable-list": {
      "types": "./dist/components/sortable-list/index.d.ts",
      "import": "./dist/components/sortable-list/index.js",
      "default": "./dist/components/sortable-list/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/copy-package-assets.mjs --package dnd",
    "prebuild": "node --input-type=module -e \"import { rm } from 'node:fs/promises'; await rm('dist', { recursive: true, force: true })\"",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2"
  },
  "peerDependenciesMeta": {
    "@dnd-kit/core": {
      "optional": true
    },
    "@dnd-kit/modifiers": {
      "optional": true
    },
    "@dnd-kit/sortable": {
      "optional": true
    },
    "@dnd-kit/utilities": {
      "optional": true
    }
  },
  "dependencies": {
    "@consona/interface-core": "^1.0.0",
    "@consona/interface-sound": "^1.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=18"
  }
}
