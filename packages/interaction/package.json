{
  "name": "@consona/interface-interaction",
  "version": "1.0.0",
  "description": "Consona Interface interaction module",
  "license": "MIT",
  "author": "Consona",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./interaction-logger": {
      "types": "./dist/components/interaction-logger/index.d.ts",
      "import": "./dist/components/interaction-logger/index.js",
      "default": "./dist/components/interaction-logger/index.js"
    },
    "./interaction-trigger": {
      "types": "./dist/components/interaction-trigger/index.d.ts",
      "import": "./dist/components/interaction-trigger/index.js",
      "default": "./dist/components/interaction-trigger/index.js"
    },
    "./interaction-zone": {
      "types": "./dist/components/interaction-zone/index.d.ts",
      "import": "./dist/components/interaction-zone/index.js",
      "default": "./dist/components/interaction-zone/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/copy-package-assets.mjs --package interaction",
    "prebuild": "node --input-type=module -e \"import { rm } from 'node:fs/promises'; await rm('dist', { recursive: true, force: true })\"",
    "type-check": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@consona/interface-core": "*"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=18"
  }
}
